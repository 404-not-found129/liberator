<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.nullmoth.a2xarm</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/a2x-keepalive.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/a2x-keepalive.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/a2x-keepalive.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
