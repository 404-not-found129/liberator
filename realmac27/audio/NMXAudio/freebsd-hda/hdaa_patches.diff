+/*
+ * Diagnostic for the port: the analog codec's live state after attach (GPIO, every pin's config, control, sense,
+ * EAPD, output amp, association; each association's pins and headphone redirect), published by the kext as the
+ * registry property "nmx-hda-diag". Read with: ioreg -rc NMXAudio -l | grep nmx-hda-diag
+ */
+void nmx_audio_diag_publish(const char *text);
+void
+nmx_hda_diag_fill(struct hdaa_devinfo *devinfo)
+{
+	static char buf[3072];
+	struct hdaa_widget *w;
+	device_t dev = devinfo->dev;
+	nid_t afg = devinfo->nid;
+	int o = 0, i, j;
+	uint32_t id = hdaa_codec_id(devinfo);
+
+	if ((id >> 16) == 0x1002 || (id >> 16) == 0x10de || (id >> 16) == 0x8086)
+		return;		/* HDMI/DP codecs: not interesting here */
+	o += snprintf(buf + o, sizeof(buf) - o, "codec 0x%08x ssid 0x%08x card 0x%08x quirks 0x%08x gpio cfg 0x%08x "
+	    "gpio data 0x%02x mask 0x%02x dir 0x%02x;", id, hda_get_subsystem_id(dev), hdaa_card_id(devinfo),
+	    devinfo->quirks, devinfo->gpio,
+	    hda_command(dev, HDA_CMD_12BIT(0, afg, 0xf15, 0)) & 0xff,
+	    hda_command(dev, HDA_CMD_12BIT(0, afg, 0xf16, 0)) & 0xff,
+	    hda_command(dev, HDA_CMD_12BIT(0, afg, 0xf17, 0)) & 0xff);
+	for (i = devinfo->startnode; i < devinfo->endnode && o < (int)sizeof(buf) - 160; i++) {
+		w = hdaa_widget_get(devinfo, i);
+		if (w == NULL || w->type != HDA_PARAM_AUDIO_WIDGET_CAP_TYPE_PIN_COMPLEX)
+			continue;
+		o += snprintf(buf + o, sizeof(buf) - o, " pin 0x%02x en %d cfg 0x%08x ctl 0x%02x sense 0x%08x eapd 0x%02x "
+		    "amp 0x%02x as %d conn %d;", w->nid, w->enable, w->wclass.pin.config,
+		    hda_command(dev, HDA_CMD_12BIT(0, w->nid, 0xf07, 0)) & 0xff,
+		    hda_command(dev, HDA_CMD_12BIT(0, w->nid, 0xf09, 0)),
+		    hda_command(dev, HDA_CMD_12BIT(0, w->nid, 0xf0c, 0)) & 0xff,
+		    hda_command(dev, ((uint32_t)w->nid << 20) | (0xbU << 16) | 0xa000) & 0xff,
+		    w->bindas, w->wclass.pin.connected);
+	}
+	for (i = 0; i < devinfo->ascnt && o < (int)sizeof(buf) - 120; i++) {
+		struct hdaa_audio_as *as = &devinfo->as[i];
+		o += snprintf(buf + o, sizeof(buf) - o, " as%d %s en %d hpredir %d pins", i, as->dir == HDAA_CTL_OUT ?
+		    "out" : "in", as->enable, as->hpredir);
+		for (j = 0; j < 16; j++)
+			if (as->pins[j] > 0)
+				o += snprintf(buf + o, sizeof(buf) - o, " %d:0x%02x", j, as->pins[j]);
+		o += snprintf(buf + o, sizeof(buf) - o, ";");
+	}
+	nmx_audio_diag_publish(buf);
+}
