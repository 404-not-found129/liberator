+		hda_command(dev, HDA_CMD_12BIT(0, 0x24, 0x703, 0x01));
+		hdaa_write_coef(dev, 0x24, 0x33, 0x0001);
+		hdaa_write_coef(dev, 0x24, 0x34, 0x1c01);
+	}
 	if (id == HDA_CODEC_ALC269) {
