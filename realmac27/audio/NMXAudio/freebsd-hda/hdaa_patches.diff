+	/*
+	 * Apple machines with the Cirrus CS4208 (Mac Pro 6,1, Mac mini 7,1, MacBook Pro 11,x/12,1, MacBook Air 6,x)
+	 * switch the internal speaker amplifier with GPIO0; without it every output plays and the speaker stays silent.
+	 * Linux applies this to every Apple CS4208 (patch_cirrus.c cs4208_fixup_mac: gpio_eapd_speaker = 1). The Mac Pro
+	 * 6,1 controller reports an Intel PCI subsystem (8086:7270), so the codec's own subsystem id is checked as well.
+	 */
+	if (id == HDA_CODEC_CS4208 && devinfo->gpio == 0 &&
+	    ((subsystemid >> 16) == APPLE_VENDORID || (subid & 0xffff) == APPLE_VENDORID || subid == 0x72708086))
+		devinfo->gpio = HDAA_GPIO_SET(0);
+	/*
+	 * Mac Pro 6,1 (codec 0x106b7800) and Mac mini 7,1 (0x106b6c00): the headphone pin (0x10) reports presence
+	 * inverted, so without this the driver sees headphones in, automutes the speaker and nothing is heard. Linux sets
+	 * inv_jack_detect for the codec and turns presence detect off on the mic (0x18) and SPDIF (0x21) pins (below).
+	 */
+	if (id == HDA_CODEC_CS4208 && (subsystemid == 0x106b7800 || subsystemid == 0x106b6c00))
+		devinfo->quirks |= HDAA_QUIRK_SENSEINV;
+	if (id == HDA_CODEC_CS4208)
+		device_printf(devinfo->dev, "CS4208 card 0x%08x codec subsystem 0x%08x gpio 0x%08x\n",
+		    subid, subsystemid, devinfo->gpio);
+
 	/* Apply per-widget patch. */
